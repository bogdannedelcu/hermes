[Unit]
Description=EBS Chronos-2 Forecasting Service (FastAPI on :8081)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/ebsv2/python/timesfm_service
EnvironmentFile=/var/www/ebsv2/python/timesfm_service/.env
ExecStart=/var/www/ebsv2/python/timesfm_service/venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 8081 \
    --workers 1 \
    --log-level info
Restart=on-failure
RestartSec=5

# Hardening — filesystem mostly read-only except for HF cache + log location.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log /var/www/.cache /var/www/ebsv2/python/timesfm_service
PrivateTmp=true

[Install]
WantedBy=multi-user.target
